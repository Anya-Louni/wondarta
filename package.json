{
  "name": "wondarta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Wondarta: a walkable 3D encyclopedia for kids.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:content && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "validate:content": "node scripts/validate-content.mjs",
    "test": "node --experimental-strip-types tests/guards.test.mts && node scripts/validate-content.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~5.9",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@huggingface/transformers": "^4.3.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.47.0",
    "onnxruntime-web": "^1.18.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "three": "^0.186.0",
    "zustand": "^5.0.15"
  }
}
