# Copy to .env.local (never commit it). Both providers are free tier, no credit card.
# Keys are used ONLY by the Vite dev proxy (vite.config.ts); they are never bundled.

# Groq (https://console.groq.com/keys): powers the mascot (quiz framing + Mascot Room chat)
GROQ_API_KEY=
# Google Gemini (https://aistudio.google.com/apikey): powers "Ask about anything",
# "I want more!" variants and Wikipedia-grounded Learn More
GEMINI_API_KEY=

# Optional model overrides (public, safe to expose)
VITE_GROQ_MODEL=qwen/qwen3.8-27b
VITE_GEMINI_MODEL=gemini-3.5-flash-lite
